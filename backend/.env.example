PORT=8080
GIN_MODE=debug
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_coach?sslmode=disable
JWT_SECRET=your-secret-key-change-this-to-something-secure-min-32-chars
GEMINI_API_KEY=your-gemini-api-key-here
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# S3 Storage Configuration
S3_ENDPOINT=localhost:9000
S3_BUCKET=ai-coach-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# Google Drive Configuration (Optional)
# Path to a Google service-account JSON key, and the Drive folder to copy recordings into.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_DRIVE_FOLDER_ID=

# Email Configuration (Resend, optional). Empty = emails are printed to the log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin / Monitoring Dashboard (Optional)
# On startup, the user with this email is promoted to the "admin" role so they
# can access the /api/v1/admin/* monitoring endpoints. Leave blank to disable.
ADMIN_BOOTSTRAP_EMAIL=
