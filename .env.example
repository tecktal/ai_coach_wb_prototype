# Copy this file to .env and fill it in. docker-compose.yml reads it.
# Never commit .env — it is gitignored.

# --- Required -----------------------------------------------------------------

# Google Gemini key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Signs login tokens. Use a long random string, e.g.:
#   openssl rand -hex 32
#   or PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=change-me-to-a-long-random-string

# Database (PostgreSQL container). Change the password for anything beyond a laptop.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_coach

# Audio storage (MinIO container). These are also the MinIO console login.
# The secret must be at least 8 characters.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Optional -----------------------------------------------------------------

# Email of the account to make "admin" on startup, so it can sign in to the
# monitoring dashboard. Register this account in the app first, then restart
# the backend so it reads this file again:
#   docker compose up -d --force-recreate backend
ADMIN_BOOTSTRAP_EMAIL=

# Sends verification and password-reset emails through https://resend.com.
# Leave empty and the emails are printed to the backend log instead
# (docker compose logs backend), which is enough for a local deployment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Which browser origins may call the API. "*" allows any — fine locally.
# On a server, list the dashboard's address, e.g. https://dashboard.example.org
CORS_ORIGINS=*

# Backend URL the dashboard's browser code calls (used when building it with
# `docker compose --profile dashboard up`). No trailing slash, no /api/v1.
DASHBOARD_API_BASE_URL=http://localhost:8080

# Gin mode: "release" (default) or "debug" for verbose logging.
GIN_MODE=release

# Host ports, if the defaults clash with something already running.
# BACKEND_HOST_PORT=8080
# POSTGRES_HOST_PORT=5432
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# DASHBOARD_HOST_PORT=3000
